{
    "name": "maxim/axonphp-cli",
    "description": "Zero-config CLI that inspects your PHP project and generates a ready-to-run CI pipeline for GitHub Actions, GitLab CI, Bitbucket Pipelines or CircleCI.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cli",
        "php",
        "ci",
        "ci-cd",
        "github-actions",
        "gitlab-ci",
        "bitbucket-pipelines",
        "circleci",
        "generator",
        "scaffolding"
    ],
    "homepage": "https://github.com/maximilianfeix/AxonPHPCLI",
    "support": {
        "issues": "https://github.com/maximilianfeix/AxonPHPCLI/issues",
        "source": "https://github.com/maximilianfeix/AxonPHPCLI"
    },
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.4",
        "symfony/console": "^7.3 || ^8.0"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/yaml": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "AxonPHP\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AxonPHP\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/axonphp"
    ],
    "extra": {
        "axonphp": {
            "branches": ["main", "develop"],
            "coverage": true,
            "min-coverage": 100,
            "lowest": true,
            "audit": true
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs",
            "@stan",
            "@test",
            "@ci:check"
        ],
        "ci:check": "@php bin/axonphp ci:check",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text"
        ],
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "site": "@php site/build.php",
        "site:check": "@php site/build.php --check",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "check": "Run code style, static analysis, tests and the pipeline check",
        "ci:check": "Check that the CI workflow matches the project",
        "coverage": "Run the test suite and print the line coverage",
        "cs": "Check the code style without changing files",
        "cs:fix": "Fix the code style",
        "site": "Rebuild the website in docs/",
        "site:check": "Check that the website in docs/ is up to date",
        "stan": "Run PHPStan",
        "test": "Run the test suite"
    }
}
