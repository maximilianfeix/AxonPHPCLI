#!/usr/bin/env php
<?php

declare(strict_types=1);

use AxonPHP\Cli\Application;

$autoloaders = [
    // Installed as a dependency: vendor/maxim/axonphp-cli/bin
    __DIR__.'/../../../autoload.php',
    // Running from a clone of the repository
    __DIR__.'/../vendor/autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;

        exit((new Application())->run());
    }
}

fwrite(STDERR, 'Dependencies are missing. Run "composer install" first.'.PHP_EOL);

exit(1);
